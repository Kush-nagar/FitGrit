rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow access to user documents and subcollections
    match /users/{userId}/{document=**} {
      // For development: allow all read and write operations
      // TODO: Replace with proper authentication rules before production
      allow read, write: if true;
    }
    
    // If you have other collections at the root level, add rules for them here
    // Example for a public collection:
    // match /public_data/{document=**} {
    //   allow read: if true;
    //   allow write: if request.auth != null;
    // }
  }
}
